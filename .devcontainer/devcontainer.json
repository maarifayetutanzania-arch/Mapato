{
  "name": "Mapato Binafsi Flutter + Firebase",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/flutter:1": {
      "channel": "stable"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21"
    }
  },
  "postCreateCommand": "npm install -g firebase-tools && dart pub global activate flutterfire_cli && flutter pub get && npm --prefix functions ci",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "Firebase.vscode-firebase-explorer",
        "GitHub.vscode-github-actions"
      ]
    }
  },
  "forwardPorts": [5000, 5001, 8080, 9000, 9099],
  "portsAttributes": {
    "5000": {"label": "Firebase Hosting emulator", "onAutoForward": "notify"},
    "5001": {"label": "Firebase Functions emulator", "onAutoForward": "silent"},
    "8080": {"label": "Firestore emulator", "onAutoForward": "silent"},
    "9000": {"label": "Realtime Database emulator", "onAutoForward": "silent"},
    "9099": {"label": "Firebase Auth emulator", "onAutoForward": "silent"}
  }
}
