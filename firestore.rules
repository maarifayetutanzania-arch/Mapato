rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUser(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validAmount(data, field) {
      return data[field] is int && data[field] >= 0 && data[field] <= 1000000000000000;
    }

    function validProfile(data) {
      return data.keys().hasAll([
          'displayName', 'email', 'currency', 'language',
          'monthlyIncomeMinor', 'monthlyBudgetMinor', 'financialGoal',
          'setupComplete', 'createdAt', 'updatedAt'
        ])
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 100
        && data.email is string
        && data.email.size() <= 320
        && data.currency in ['TZS', 'USD', 'KES']
        && data.language in ['en', 'sw']
        && validAmount(data, 'monthlyIncomeMinor')
        && validAmount(data, 'monthlyBudgetMinor')
        && data.financialGoal is string
        && data.financialGoal.size() > 0
        && data.financialGoal.size() <= 100
        && data.setupComplete is bool
        && data.updatedAt == request.time;
    }

    function validTransaction(data) {
      return data.keys().hasAll([
          'type', 'amountMinor', 'currency', 'categoryId', 'description',
          'date', 'note', 'monthKey', 'createdAt', 'updatedAt'
        ])
        && data.type in ['income', 'expense']
        && data.amountMinor is int
        && data.amountMinor > 0
        && data.amountMinor <= 1000000000000000
        && data.currency in ['TZS', 'USD', 'KES']
        && data.categoryId is string
        && data.categoryId.size() > 0
        && data.categoryId.size() <= 100
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 200
        && data.note is string
        && data.note.size() <= 1000
        && data.date is timestamp
        && data.monthKey is string
        && data.monthKey.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function validBudget(data) {
      return data.keys().hasAll([
          'categoryId', 'amountMinor', 'currency', 'monthKey', 'createdAt', 'updatedAt'
        ])
        && data.categoryId is string
        && data.categoryId.size() > 0
        && data.amountMinor is int
        && data.amountMinor > 0
        && data.amountMinor <= 1000000000000000
        && data.currency in ['TZS', 'USD', 'KES']
        && data.monthKey is string
        && data.monthKey.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function validGoal(data) {
      return data.keys().hasAll([
          'name', 'targetMinor', 'currentMinor', 'currency', 'targetDate', 'createdAt', 'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.targetMinor is int
        && data.targetMinor > 0
        && data.targetMinor <= 1000000000000000
        && data.currentMinor is int
        && data.currentMinor >= 0
        && data.currentMinor <= data.targetMinor
        && data.currency in ['TZS', 'USD', 'KES']
        && (data.targetDate == null || data.targetDate is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function validDebt(data) {
      return data.keys().hasAll([
          'name', 'person', 'direction', 'amountMinor', 'paidMinor',
          'currency', 'dueDate', 'note', 'createdAt', 'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.person is string
        && data.person.size() <= 200
        && data.direction in ['owedByMe', 'owedToMe']
        && data.amountMinor is int
        && data.amountMinor > 0
        && data.amountMinor <= 1000000000000000
        && data.paidMinor is int
        && data.paidMinor >= 0
        && data.paidMinor <= data.amountMinor
        && data.currency in ['TZS', 'USD', 'KES']
        && (data.dueDate == null || data.dueDate is timestamp)
        && data.note is string
        && data.note.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if ownsUser(userId);
      allow create: if ownsUser(userId)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if ownsUser(userId)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /transactions/{transactionId} {
        allow read: if ownsUser(userId);
        allow create: if ownsUser(userId)
          && validTransaction(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if ownsUser(userId)
          && validTransaction(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if ownsUser(userId);
      }

      match /budgets/{budgetId} {
        allow read: if ownsUser(userId);
        allow create: if ownsUser(userId)
          && validBudget(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if ownsUser(userId)
          && validBudget(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if ownsUser(userId);
      }

      match /savingsGoals/{goalId} {
        allow read: if ownsUser(userId);
        allow create: if ownsUser(userId)
          && validGoal(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if ownsUser(userId)
          && validGoal(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if ownsUser(userId);

        match /history/{entryId} {
          allow read: if ownsUser(userId);
          allow create: if ownsUser(userId)
            && request.resource.data.keys().hasOnly(['deltaMinor', 'createdAt'])
            && request.resource.data.keys().hasAll(['deltaMinor', 'createdAt'])
            && request.resource.data.deltaMinor is int
            && request.resource.data.deltaMinor != 0
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }
      }

      match /debts/{debtId} {
        allow read: if ownsUser(userId);
        allow create: if ownsUser(userId)
          && validDebt(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if ownsUser(userId)
          && validDebt(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if ownsUser(userId);
      }

      match /categories/{categoryId} {
        allow read: if ownsUser(userId);
        allow create: if ownsUser(userId)
          && request.resource.data.keys().hasOnly(['name', 'type', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasAll(['name', 'type', 'createdAt', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 32
          && request.resource.data.type in ['income', 'expense']
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if ownsUser(userId)
          && request.resource.data.keys().hasOnly(['name', 'type', 'createdAt', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 32
          && request.resource.data.type in ['income', 'expense']
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if ownsUser(userId);
      }

      match /summaries/{summaryId} {
        allow read: if ownsUser(userId);
        allow write: if false;
      }

      match /summaryOperations/{operationId} {
        allow read, write: if false;
      }

      match /notifications/{notificationId} {
        allow read, write: if ownsUser(userId);
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /_authChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
